/// Demo project schedule for the Gantt preview page (fictional).
table Projects
	lineageTag: f05811d0-8210-4e21-a122-8eb2ec40580a

	/// Earliest start in context; drives the Gantt Start well.
	measure 'Task Start' = MIN ( Projects[Start] )
		formatString: dd.mm.yyyy
		lineageTag: 56104d17-8a30-43b8-9236-c896aa82f8f2

	/// Latest end in context; blank for milestones, which the Gantt draws as markers.
	measure 'Task End' = MAX ( Projects[End] )
		formatString: dd.mm.yyyy
		lineageTag: 7a58f616-8326-4852-bb28-b11b6ca37ab9

	/// Share complete; milestones carry no progress and are ignored by AVERAGE.
	measure 'Task Progress' = AVERAGE ( Projects[Progress] )
		formatString: 0%
		lineageTag: 38058c2d-62f3-4cb1-ade6-dc8a138d600f

	/// Owner of a single task; blank on phase rows.
	measure 'Task Owner' = IF ( ISINSCOPE ( Projects[Task] ), SELECTEDVALUE ( Projects[Owner] ) )
		lineageTag: 4f223617-58e1-407e-b4ed-c1c1a098e7e8

	/// Status of a single task; blank on phase rows.
	measure 'Task Status' = IF ( ISINSCOPE ( Projects[Task] ), SELECTEDVALUE ( Projects[Status] ) )
		lineageTag: 7044d4a7-434d-4959-bc4d-02aeb70b36bd

	/// Tasks with a duration; milestones excluded.
	measure Tasks = CALCULATE ( COUNTROWS ( Projects ), NOT ISBLANK ( Projects[End] ) )
		formatString: 0
		lineageTag: b766c1de-5756-4f8e-a907-2392d7f01507

	measure 'Tasks Done' = CALCULATE ( [Tasks], Projects[Status] = "Done" )
		formatString: 0
		lineageTag: 8d554a32-cccc-42be-9706-506da26f4d81

	measure Milestones = CALCULATE ( COUNTROWS ( Projects ), ISBLANK ( Projects[End] ) )
		formatString: 0
		lineageTag: 86f328ce-cd01-4506-a947-123f7015280c

	measure 'Milestones Reached' = CALCULATE ( [Milestones], Projects[Status] = "Done" )
		formatString: 0
		lineageTag: d2b36b73-7ed9-454b-9b75-13f76a4d8db3

	/// Share complete, weighted by task duration.
	measure 'Weighted Progress' =
			VAR t = FILTER ( Projects, NOT ISBLANK ( Projects[End] ) )
			RETURN DIVIDE ( SUMX ( t, Projects[Progress] * ( Projects[End] - Projects[Start] ) ), SUMX ( t, Projects[End] - Projects[Start] ) )
		formatString: 0%
		lineageTag: c4cf0c95-dca4-467d-91ff-b5e43f78c860

	measure 'Go-live Date' = CALCULATE ( MIN ( Projects[Start] ), Projects[Task] = "Go-live", REMOVEFILTERS ( Projects ) )
		formatString: dd.mm.yyyy
		lineageTag: f6815903-c479-405a-8fb3-d62fae5d4827

	/// Tasks not yet done.
	measure 'Open Tasks' = [Tasks] - [Tasks Done]
		formatString: 0
		lineageTag: 274e86db-e555-4e52-99e3-b1feb0139518

	column Phase
		lineageTag: a0c6fcc3-c06e-464b-b862-b82f0a0d3efb
		isNameInferred
		sourceColumn: [Phase]
		sortByColumn: 'Phase No'

	column Task
		lineageTag: 765888bc-eae8-4ca0-b4c8-2868dff7a622
		isNameInferred
		sourceColumn: [Task]

	column Owner
		lineageTag: b4d64b9f-8e94-4303-a0b8-8c431f0527da
		isNameInferred
		sourceColumn: [Owner]

	column Status
		lineageTag: 7fe42c23-1913-4b8d-be3d-a7f5e3666e6b
		isNameInferred
		sourceColumn: [Status]

	column Start
		formatString: dd.mm.yyyy
		lineageTag: b570bb78-4701-4d6c-b276-997df8211a79
		isNameInferred
		sourceColumn: [Start]

	column End
		formatString: dd.mm.yyyy
		lineageTag: 9c654144-8275-48b1-a601-211ec5642083
		isNameInferred
		sourceColumn: [End]

	column Progress
		formatString: 0%
		lineageTag: 2c96f0db-3345-4966-a07c-d19a48cb856a
		summarizeBy: none
		isNameInferred
		sourceColumn: [Progress]

	column 'Phase No'
		isHidden
		lineageTag: 14f29816-5e22-441e-94f5-305df77a0c7b
		summarizeBy: none
		isNameInferred
		sourceColumn: [Phase No]

	partition Projects = calculated
		mode: import
		source =
				DATATABLE(
				    "Phase No", INTEGER, "Phase", STRING, "Task", STRING, "Owner", STRING, "Status", STRING,
				    "Start", DATETIME, "End", DATETIME, "Progress", DOUBLE,
				    {
				        { 1, "Discovery", "Kickoff", "Product", "Done", "2026-07-06", BLANK(), BLANK() },
				        { 1, "Discovery", "Audit existing reports", "Analytics", "Done", "2026-07-06", "2026-07-24", 1 },
				        { 1, "Discovery", "Collect requirements", "Product", "Done", "2026-07-13", "2026-08-07", 1 },
				        { 2, "Design", "Token architecture", "Design", "Done", "2026-08-03", "2026-08-28", 1 },
				        { 2, "Design", "Chart presets", "Design", "Done", "2026-08-17", "2026-09-11", 1 },
				        { 2, "Design", "Card and slicer styles", "Design", "Done", "2026-08-31", "2026-09-25", 1 },
				        { 2, "Design", "Design sign-off", "Product", "Done", "2026-09-25", BLANK(), BLANK() },
				        { 3, "Build", "Theme build and checks", "Engineering", "Done", "2026-09-07", "2026-10-02", 1 },
				        { 3, "Build", "Migrate reports", "Engineering", "In progress", "2026-09-28", "2026-10-30", 0.65 },
				        { 3, "Build", "Accessibility review", "Design", "In progress", "2026-10-12", "2026-10-23", 0.5 },
				        { 4, "Rollout", "Pilot reports", "Analytics", "Planned", "2026-10-26", "2026-11-13", 0 },
				        { 4, "Rollout", "Author training", "Product", "Planned", "2026-11-09", "2026-11-20", 0 },
				        { 4, "Rollout", "Go-live", "Product", "Planned", "2026-11-30", BLANK(), BLANK() },
				        { 4, "Rollout", "Support period", "Engineering", "Planned", "2026-11-30", "2026-12-18", 0 }
				    }
				)

