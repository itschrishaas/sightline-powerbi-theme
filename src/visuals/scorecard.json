{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/refs/heads/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.159.json",
  "name": "scorecard",
  "visualStyles": {
    "scorecard": {
      "*": {
        "title": [
          {
            "show": false
          }
        ],
        "scorecard": [
          {
            "backgroundColor": {
              "solid": {
                "color": "{{surfaces.card}}"
              }
            },
            "tableBackgroundColor": {
              "solid": {
                "color": "{{surfaces.card}}"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "{{otherColors.text}}"
              }
            }
          }
        ],
        "header": [
          {
            "backgroundColor": {
              "solid": {
                "color": "{{surfaces.card}}"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "{{otherColors.text}}"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "show": true,
            "foregroundColor": {
              "solid": {
                "color": "{{otherColors.text}}"
              }
            }
          }
        ],
        "goals": [
          {
            "backgroundColor": {
              "solid": {
                "color": "{{surfaces.card}}"
              }
            },
            "foregroundColor": {
              "solid": {
                "color": "{{otherColors.text}}"
              }
            }
          }
        ]
      }
    }
  }
}
