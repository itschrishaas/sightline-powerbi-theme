            "titleFontColor": {
              "solid": {
                "color": "{{darkPanel.text_muted}}"
              }
            },
            "titleFontSize": "{{font.sizes.xs}}",
            "titleFontFamily": "{{font.family}}"
          }
        ],
        "referenceLabelValue": [
          {
            "$id": "default",
            "show": true,
            "valueFontColor": {
              "solid": {
                "color": "{{darkPanel.text}}"
              }
            },
            "valueFontSize": "{{font.sizes.xs}}",
            "valueFontFamily": "{{font.semibold.family}}",
            "showBlankAs": "0"
          }
        ],
        "referenceLabelDetail": [
          {
            "$id": "default",
            "show": false,
            "detailFontColor": {
              "solid": {
                "color": "{{darkPanel.text_muted}}"
              }
            },
            "detailFontSize": "{{font.sizes.xs}}",
            "detailFontFamily": "{{font.family}}",
            "detailUnderline": false,
            "detailBold": false,
            "detailItalic": false,
            "showBlankAs": "0"
          }
        ],
        "accentBar": [
          {
            "$id": "default",
            "show": true,
            "position": "Top",
            "width": 4,
            "color": {
              "solid": {
                "color": "{{darkPanel.accent}}"
              }
            }
          }
        ],
        "divider": [
          {
            "$id": "default",
            "show": true,
            "dividerColor": {
              "solid": {
                "color": "{{darkPanel.border}}"
              }
            },
            "dividerWidth": 1,
            "dividerIgnorePadding": true
          }
        ],
        "smallMultiplesBorder": [
          {
            "gridlineColor": {
              "solid": {
                "color": "{{darkPanel.border}}"
              }
            }
          }
        ],
        "smallMultiplesCellBackGround": [
          {
            "backgroundShow": false,
            "backgroundTransparency": 100
          }
        ],
        "image": [
          {
            "$id": "default",
            "show": true,
            "position": "Bottom",
            "imageAreaSize": 25
          }
        ],
        "visualHeader": [
          {
            "showTooltipButton": true
          }
        ]
      }
    }
  }
}
